pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(
      logRotator(
        numToKeepStr: '20',
        artifactNumToKeepStr: '10'
      )
    )
  }

  parameters {
    string(
      name: 'STAGING_HOST',
      defaultValue: 'staging.vaultbank.internal',
      description: 'Vault Bank staging hostname'
    )
    string(
      name: 'STAGING_NODE_IP',
      defaultValue: '172.31.47.209',
      description: 'K3s staging node private IP used for project-local DNS bypass'
    )
    string(
      name: 'KUBECONFIG_PATH',
      defaultValue: '/var/lib/jenkins/.kube/k3s.yaml',
      description: 'Kubeconfig used by Jenkins for k3s/Argo CD checks; must not point to Jenkins'
    )
    string(
      name: 'DEFECTDOJO_URL',
      defaultValue: '',
      description: 'Optional DefectDojo base URL. Empty uses STAGING_NODE_IP:8081, then localhost fallbacks.'
    )
  }

  environment {
    NODE_OPTIONS = '--max-old-space-size=1024'
    CI = 'true'
    STAGING_HOST = "${params.STAGING_HOST}"
    STAGING_NODE_IP = "${params.STAGING_NODE_IP}"
    KUBECONFIG = "${params.KUBECONFIG_PATH}"
    DEFECTDOJO_URL = "${params.DEFECTDOJO_URL}"
  }

  stages {
    stage('01 Checkout') {
      steps {
        cleanWs(deleteDirs: true)

        checkout scm

        sh '''
          set -Eeuo pipefail

          if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
            git fetch --unshallow --tags origin
          else
            git fetch --tags --force --prune origin
          fi

          mkdir -p reports/phase-02-ci-baseline

          git rev-parse HEAD |
            tee reports/phase-02-ci-baseline/git-commit.txt

          git branch --show-current |
            tee reports/phase-02-ci-baseline/git-branch.txt

          git status --porcelain |
            tee reports/phase-02-ci-baseline/git-status-before.txt

          node --version |
            tee reports/phase-02-ci-baseline/node-version.txt

          npm --version |
            tee reports/phase-02-ci-baseline/npm-version.txt
        '''
      }
    }

    stage('02 Repository validation') {
      steps {
        sh '''
          set -Eeuo pipefail

          bash ci/scripts/validate-repository.sh 2>&1 |
            tee reports/phase-02-ci-baseline/repository-validation.log

          bash ci/scripts/validate-all-files.sh 2>&1 |
            tee reports/phase-02-ci-baseline/file-hygiene.log

          git diff --check
        '''
      }
    }

    stage('03 Pinned security tool verification') {
      steps {
        sh '''
          set -Eeuo pipefail

          bash ci/scripts/verify-tool-versions.sh
        '''
      }
    }

    stage('04 TruffleHog verified-secret gate') {
      steps {
        sh '''
          set -Eeuo pipefail

          bash ci/scripts/run-trufflehog.sh all
        '''
      }
    }

    stage('05 Backend quality gates') {
      steps {
        dir('backend-service') {
          sh '''
            set -Eeuo pipefail

            npm ci --legacy-peer-deps 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-npm-ci.log

            npm run lint:check 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-lint.log

            npm run build:all 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-build.log

            npm test 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-tests.log

            npm run test:cov:all 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-coverage.log

            npm audit --audit-level=high 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-npm-audit.log

            git diff --exit-code -- \
              package.json \
              package-lock.json
          '''
        }
      }
    }

    stage('06 Frontend quality gates') {
      steps {
        dir('frontend') {
          sh '''
            set -Eeuo pipefail

            npm ci 2>&1 |
              tee ../reports/phase-02-ci-baseline/frontend-npm-ci.log

            npm run typecheck 2>&1 |
              tee ../reports/phase-02-ci-baseline/frontend-typecheck.log

            npm run build 2>&1 |
              tee ../reports/phase-02-ci-baseline/frontend-build.log

            npm audit --audit-level=high 2>&1 |
              tee ../reports/phase-02-ci-baseline/frontend-npm-audit.log

            test -s dist/index.html

            git diff --exit-code -- \
              package.json \
              package-lock.json
          '''
        }
      }
    }

    stage('07 SonarQube Cloud SAST quality gate') {
      when {
        branch 'main'
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'sonarcloud-token',
            variable: 'SONAR_TOKEN'
          )
        ]) {
          sh '''
            set -Eeuo pipefail

            export SONAR_USER_HOME=/var/lib/jenkins/.sonar
            export SONAR_QUALITY_GATE_TIMEOUT=300
            export SONAR_GATE_NAME='Vault Bank POC Quality Gate'
            export SONAR_SYNC_QUALITY_GATE=0
            export SONAR_SERVER_QUALITY_GATE_WAIT=false
            export SONAR_CE_TIMEOUT=300
            export SONAR_CE_POLL_SECONDS=5

            bash ci/scripts/run-sonar.sh
          '''
        }
      }
    }

    stage('08 OWASP Dependency-Check CVSS gate') {
      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'nvd-api-key',
            variable: 'NVD_API_KEY'
          )
        ]) {
          sh '''
            set -Eeuo pipefail

            export DEPENDENCY_CHECK_DATA_DIR=/var/lib/jenkins/dependency-check-data
            export DEPENDENCY_CHECK_RUNTIME_DIR=/var/lib/jenkins/dependency-check-runtime
            export DEPENDENCY_CHECK_FAIL_ON_CVSS=7.0

            bash ci/scripts/run-dependency-check.sh
          '''
        }
      }

      post {
        always {
          junit(
            allowEmptyResults: true,
            testResults: 'reports/phase-05-dependency-check/dependency-check-junit.xml'
          )

          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-05-dependency-check/**',
            fingerprint: true
          )
        }
      }
    }

    stage('09 Trivy filesystem, secret and IaC gate') {
      options {
        timeout(time: 30, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export TRIVY_CACHE_DIR=/var/lib/jenkins/trivy-cache

          bash ci/scripts/run-trivy-fs.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-06-trivy-fs/**',
            fingerprint: true
          )
        }
      }
    }

    stage('10 Deterministic Docker image build') {
      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export DOCKER_BUILDKIT=1
          export LOCAL_IMAGE_PREFIX=vaultbank

          bash ci/scripts/build-images.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-07-build/**',
            fingerprint: true
          )
        }
      }
    }

    stage('11 Trivy container image security gate') {
      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export TRIVY_CACHE_DIR=/var/lib/jenkins/trivy-cache

          bash ci/scripts/scan-images.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-08-trivy-image/**',
            fingerprint: true
          )
        }
      }
    }

    stage('12 Syft SBOM generation and validation') {
      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export SYFT_CHECK_FOR_APP_UPDATE=false

          bash ci/scripts/generate-sboms.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-09-sbom/**',
            fingerprint: true
          )
        }
      }
    }

    stage('13 Cosign AWS KMS signing preflight') {
      options {
        timeout(time: 20, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export AWS_REGION=us-east-1
          export AWS_DEFAULT_REGION=us-east-1
          export AWS_EC2_METADATA_DISABLED=false
          export NO_PROXY="${NO_PROXY:+${NO_PROXY},}169.254.169.254"
          export no_proxy="${no_proxy:+${no_proxy},}169.254.169.254"

          bash ci/scripts/cosign-kms-preflight.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-10-cosign-kms-preflight/**',
            fingerprint: true
          )
        }
      }
    }

    stage('14 Harbor image publication and digest capture') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'harbor-vault-bank-robot',
            usernameVariable: 'HARBOR_USERNAME',
            passwordVariable: 'HARBOR_PASSWORD'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            export HARBOR_REGISTRY='harbor.vaultbank.internal:9443'
            export HARBOR_PROJECT='vault-bank'
            export HARBOR_AUTO_SBOM_REQUIRED=0
            export HARBOR_ENSURE_AUTO_SBOM_ENABLED=0
            export HARBOR_AUTO_SBOM_TIMEOUT_SECONDS=900
            export HARBOR_AUTO_SBOM_POLL_SECONDS=15

            bash ci/scripts/publish-images-to-harbor.sh
          '''
        }
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-10-harbor-publish/**',
            fingerprint: true
          )
        }
      }
    }

    stage('15 Trivy Harbor digest security gate') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 60, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'harbor-vault-bank-robot',
            usernameVariable: 'HARBOR_USERNAME',
            passwordVariable: 'HARBOR_PASSWORD'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            export HARBOR_REGISTRY='harbor.vaultbank.internal:9443'
            export HARBOR_PROJECT='vault-bank'

            bash ci/scripts/scan-harbor-digests.sh
          '''
        }
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-11-trivy-registry/**',
            fingerprint: true
          )
        }
      }
    }

    stage('16 Cosign KMS signatures and SPDX attestations') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 60, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'harbor-vault-bank-robot',
            usernameVariable: 'HARBOR_USERNAME',
            passwordVariable: 'HARBOR_PASSWORD'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            export AWS_REGION='us-east-1'
            export AWS_DEFAULT_REGION='us-east-1'
            export AWS_EC2_METADATA_DISABLED='false'

            export NO_PROXY="${NO_PROXY:+${NO_PROXY},}169.254.169.254"
            export no_proxy="${no_proxy:+${no_proxy},}169.254.169.254"

            export HARBOR_REGISTRY='harbor.vaultbank.internal:9443'
            export HARBOR_PROJECT='vault-bank'

            bash ci/scripts/sign-attest-harbor-images.sh
          '''
        }
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-12-cosign-oci/**',
            fingerprint: true
          )
        }
      }
    }

    stage('17 Release Manifest') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 20, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export AWS_REGION='us-east-1'
          export AWS_DEFAULT_REGION='us-east-1'
          export AWS_EC2_METADATA_DISABLED='false'

          export NO_PROXY="${NO_PROXY:+${NO_PROXY},}169.254.169.254"
          export no_proxy="${no_proxy:+${no_proxy},}169.254.169.254"

          bash ci/scripts/create-release-manifest.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-13-release-manifest/**',
            fingerprint: true
          )
        }
      }
    }

    stage('18 Argo CD Deploy - Staging') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 6, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          REPORT_DIR="reports/phase-14-argocd-staging"
          mkdir -p "${REPORT_DIR}"

          test -s "${KUBECONFIG}" || {
            echo "FAIL: Jenkins kubeconfig is missing: ${KUBECONFIG}"
            exit 1
          }

          KUBE_SERVER="$(
            kubectl \
              config view \
              --minify \
              --output jsonpath='{.clusters[0].cluster.server}' \
              2>/dev/null || true
          )"

          printf 'KubeServer=%s\n' "${KUBE_SERVER:-unknown}" |
            tee "${REPORT_DIR}/kubeconfig-preflight.log"

          case "${KUBE_SERVER}" in
            "" | http://* | *:8080*)
              echo "FAIL: kubeconfig is not pointing to the k3s API server"
              echo "Expected a k3s API URL such as https://127.0.0.1:6443"
              echo "Actual: ${KUBE_SERVER:-empty}"
              exit 1
              ;;
          esac

          kubectl \
            --request-timeout=10s \
            get namespace argocd \
            >/dev/null

          publish_staging_ingress_status() {
            if [ "${INGRESS_STATUS_PUBLISHED:-0}" = "1" ]; then
              return 0
            fi

            STAGING_NODE_IP="$(
              kubectl \
                get nodes \
                --output jsonpath='{range .items[*]}{range .status.addresses[?(@.type=="InternalIP")]}{.address}{"\\n"}{end}{end}' |
                sed -n '1p'
            )"

            if [ -z "${STAGING_NODE_IP}" ]; then
              echo "WARN: unable to discover k3s node InternalIP for staging Ingress status" |
                tee -a "${REPORT_DIR}/argocd-convergence.log"
              return 0
            fi

            PATCHED_INGRESSES=0

            for INGRESS in \
              vaultbank-api-http \
              vaultbank-api-https \
              vaultbank-frontend-http \
              vaultbank-frontend-https; do

              kubectl \
                --namespace vault-bank-staging \
                get ingress "${INGRESS}" \
                >/dev/null 2>&1 ||
                continue

              if kubectl \
                --namespace vault-bank-staging \
                patch \
                ingress "${INGRESS}" \
                --subresource=status \
                --type merge \
                --patch "{\"status\":{\"loadBalancer\":{\"ingress\":[{\"ip\":\"${STAGING_NODE_IP}\"}]}}}" \
                >/dev/null 2>&1; then

                PATCHED_INGRESSES=$((PATCHED_INGRESSES + 1))
              else
                echo "WARN: unable to publish status for staging Ingress ${INGRESS}" |
                  tee -a "${REPORT_DIR}/argocd-convergence.log"
              fi
            done

            if [ "${PATCHED_INGRESSES}" -gt 0 ]; then
              INGRESS_STATUS_PUBLISHED=1
              echo "Published k3s node IP ${STAGING_NODE_IP} to ${PATCHED_INGRESSES} staging Ingress status record(s)" |
                tee -a "${REPORT_DIR}/argocd-convergence.log"

              REFRESH_STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
              kubectl \
                --namespace argocd \
                annotate \
                application vault-bank-staging \
                argocd.argoproj.io/refresh=hard \
                "vault-bank.io/ingress-status-refreshed-at=${REFRESH_STAMP}" \
                --overwrite \
                >/dev/null

              echo "Requested Argo CD hard refresh for vault-bank-staging after staging Ingress status update" |
                tee -a "${REPORT_DIR}/argocd-convergence.log"
            fi
          }

          APPLICATIONS="
          vault-bank-staging
          vault-bank-runtime-staging
          "

          for APP in ${APPLICATIONS}; do
            echo "Hard-refreshing Argo CD application ${APP}" |
              tee -a "${REPORT_DIR}/argocd-convergence.log"

            kubectl \
              --namespace argocd \
              annotate \
              application "${APP}" \
              argocd.argoproj.io/refresh=hard \
              --overwrite |
              tee -a "${REPORT_DIR}/argocd-convergence.log"
          done

          SYNC_PATCH="$(
            cat <<'JSON'
{"operation":{"initiatedBy":{"username":"jenkins"},"sync":{"revision":"main","prune":true,"syncOptions":["PruneLast=true"]}}}
JSON
          )"

          for APP in ${APPLICATIONS}; do
            echo "Requesting Argo CD sync for ${APP}" |
              tee -a "${REPORT_DIR}/argocd-convergence.log"

            if ! kubectl \
              --namespace argocd \
              patch \
              application "${APP}" \
              --type merge \
              --patch "${SYNC_PATCH}" |
              tee -a "${REPORT_DIR}/argocd-convergence.log"; then
              echo "WARN: unable to request Argo CD sync for ${APP}; continuing to wait for automated reconciliation" |
                tee -a "${REPORT_DIR}/argocd-convergence.log"
            fi
          done

          publish_staging_ingress_status

          TIMEOUT_SECONDS=300
          START_EPOCH="$(date +%s)"
          DEADLINE=$((START_EPOCH + TIMEOUT_SECONDS))

          for APP in ${APPLICATIONS}; do
            while true; do
              publish_staging_ingress_status

              SYNC_STATUS="$(
                kubectl \
                  --namespace argocd \
                  get application "${APP}" \
                  --output jsonpath='{.status.sync.status}' \
                  2>/dev/null || true
              )"

              HEALTH_STATUS="$(
                kubectl \
                  --namespace argocd \
                  get application "${APP}" \
                  --output jsonpath='{.status.health.status}' \
                  2>/dev/null || true
              )"

              printf '%s sync=%s health=%s\n' \
                "${APP}" \
                "${SYNC_STATUS:-Unknown}" \
                "${HEALTH_STATUS:-Unknown}" |
                tee -a "${REPORT_DIR}/argocd-convergence.log"

              if [ "${SYNC_STATUS}" = "Synced" ] &&
                 [ "${HEALTH_STATUS}" = "Healthy" ]; then
                break
              fi

              NOW_EPOCH="$(date +%s)"
              if [ "${NOW_EPOCH}" -ge "${DEADLINE}" ]; then
                kubectl \
                  --namespace argocd \
                  get application "${APP}" \
                  --output yaml \
                  > "${REPORT_DIR}/${APP}.yaml" || true

                kubectl \
                  --namespace argocd \
                  get application "${APP}" \
                  --output jsonpath='{range .status.resources[*]}{.group}{"/"}{.kind}{" "}{.namespace}{"/"}{.name}{" health="}{.health.status}{" message="}{.health.message}{"\\n"}{end}' |
                  grep -Ev ' health=$| health=Healthy( |$)' \
                  > "${REPORT_DIR}/${APP}-unhealthy-resources.log" || true

                echo "FAIL: ${APP} did not converge to Synced/Healthy within ${TIMEOUT_SECONDS} seconds"
                exit 1
              fi

              sleep 10
            done
          done

          echo 'PASS: Argo CD staging applications converged to Synced/Healthy' |
            tee -a "${REPORT_DIR}/argocd-convergence.log"
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-14-argocd-staging/**',
            fingerprint: true
          )
        }
      }
    }

    stage('19 Kubernetes Staging Verification') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 12, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          NAMESPACE='vault-bank-staging'
          REPORT_DIR='reports/phase-15-kubernetes-staging'
          mkdir -p "${REPORT_DIR}"

          DEPLOYMENTS="
          auth-service
          account-service
          transaction-service
          payment-service
          notification-service
          frontend
          "

          for DEPLOYMENT in ${DEPLOYMENTS}; do
            echo "Checking rollout for ${DEPLOYMENT}" |
              tee -a "${REPORT_DIR}/rollout-status.log"

            kubectl \
              --namespace "${NAMESPACE}" \
              rollout status \
              "deployment/${DEPLOYMENT}" \
              --timeout=180s |
              tee -a "${REPORT_DIR}/rollout-status.log"

            kubectl \
              --namespace "${NAMESPACE}" \
              get deployment "${DEPLOYMENT}" \
              --output yaml \
              > "${REPORT_DIR}/${DEPLOYMENT}.yaml"
          done

          kubectl \
            --namespace "${NAMESPACE}" \
            get pods \
            --output json \
            > "${REPORT_DIR}/pods.json"

          python3 - <<'PYTHON'
import json
from pathlib import Path

pods = json.loads(
    Path("reports/phase-15-kubernetes-staging/pods.json")
    .read_text(encoding="utf-8")
).get("items", [])

failures = []

for pod in pods:
    metadata = pod.get("metadata") or {}
    status = pod.get("status") or {}
    pod_name = metadata.get("name", "unknown")
    phase = status.get("phase", "Unknown")

    if phase not in {"Running", "Succeeded"}:
        failures.append(
            f"{pod_name} phase={phase}"
        )

    container_statuses = status.get("containerStatuses") or []

    if phase == "Succeeded":
        continue

    if not container_statuses:
        failures.append(
            f"{pod_name} has no live container statuses"
        )
        continue

    for container in container_statuses:
        container_name = container.get("name", "unknown")

        if container.get("ready") is not True:
            failures.append(
                f"{pod_name}/{container_name} is not Ready"
            )

if failures:
    raise SystemExit(
        "FAIL: unhealthy staging pods: "
        + "; ".join(failures)
    )

print(
    "PASS: all live staging Pod containers are Ready"
)
PYTHON
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-15-kubernetes-staging/**',
            fingerprint: true
          )
        }
      }
    }

    stage('20 Staging Smoke Test') {
      when {
        branch 'main'
      }

      steps {
        sh '''
          set -Eeuo pipefail

          STAGING_HOST="${STAGING_HOST:-staging.vaultbank.internal}"
          REPORT_DIR="${WORKSPACE}/reports/phase-11-zap"
          mkdir -p "${REPORT_DIR}"

          STAGING_NODE_IP="$(
            kubectl \
              get nodes \
              --output jsonpath='{range .items[*]}{range .status.addresses[?(@.type=="InternalIP")]}{.address}{"\\n"}{end}{end}' |
              awk 'NF { print; exit }'
          )"

          test -n "${STAGING_HOST}"
          test -n "${STAGING_NODE_IP}"

          printf 'STAGING_NODE_IP=%s\n' "${STAGING_NODE_IP}" \
            > "${REPORT_DIR}/staging-node-ip.env"

          HTTP_STATUS="$(
            curl \
              --insecure \
              --silent \
              --show-error \
              --max-time 20 \
              --output /dev/null \
              --write-out '%{http_code}' \
              --resolve "${STAGING_HOST}:443:${STAGING_NODE_IP}" \
              "https://${STAGING_HOST}/"
          )"

          {
            printf 'StagingHost=%s\n' "${STAGING_HOST}"
            printf 'StagingNodeInternalIP=%s\n' "${STAGING_NODE_IP}"
            printf 'StagingHTTP=%s\n' "${HTTP_STATUS}"
          } | tee "${REPORT_DIR}/staging-smoke.log"

          test "${HTTP_STATUS}" = '200'

          echo 'ReadyForZap=true' |
            tee -a "${REPORT_DIR}/staging-smoke.log"
        '''
      }
    }

    stage('21 OWASP ZAP Baseline DAST') {
      when {
        branch 'main'
      }

      steps {
        sh '''#!/usr/bin/env bash
          set -Eeuo pipefail

          STAGING_HOST="${STAGING_HOST:-staging.vaultbank.internal}"
          REPORT_DIR="${WORKSPACE}/reports/phase-11-zap"
          mkdir -p "${REPORT_DIR}"
          chmod 0777 "${REPORT_DIR}"

          if [ -f "${REPORT_DIR}/staging-node-ip.env" ]; then
            # shellcheck disable=SC1091
            source "${REPORT_DIR}/staging-node-ip.env"
          fi

          if [ -z "${STAGING_NODE_IP:-}" ]; then
            STAGING_NODE_IP="$(
              kubectl \
                get nodes \
                --output jsonpath='{range .items[*]}{range .status.addresses[?(@.type=="InternalIP")]}{.address}{"\\n"}{end}{end}' |
                awk 'NF { print; exit }'
            )"
          fi

          test -n "${STAGING_HOST}"
          test -n "${STAGING_NODE_IP}"

          ZAP_IMAGE='ghcr.io/zaproxy/zaproxy@sha256:35ea10525f93cfdbf81fd2b8de624f974f7559351f664415156815b49e7e0b66'

          echo '========================================'
          echo 'OWASP ZAP BASELINE DAST'
          echo '========================================'
          echo "Target=https://${STAGING_HOST}"
          echo "ReportDir=${REPORT_DIR}"
          echo "ActiveScan=false"

          set +e

          docker run \
            --rm \
            --add-host "${STAGING_HOST}:${STAGING_NODE_IP}" \
            --volume "${REPORT_DIR}:/zap/wrk:rw" \
            --workdir /zap/wrk \
            "${ZAP_IMAGE}" \
            zap-baseline.py \
            -t "https://${STAGING_HOST}" \
            -I \
            -m 1 \
            -r zap-baseline.html \
            -J zap-baseline.json \
            -x zap-baseline.xml \
            -w zap-baseline.md \
            2>&1 |
          tee "${REPORT_DIR}/zap-console.log"

          ZAP_EXIT="${PIPESTATUS[0]}"

          set -e

          printf 'ZapBaselineExit=%s\n' "${ZAP_EXIT}" |
            tee "${REPORT_DIR}/zap-exit.txt"

          for REPORT in \
            zap-baseline.html \
            zap-baseline.json \
            zap-baseline.xml \
            zap-baseline.md
          do
            test -s "${REPORT_DIR}/${REPORT}" || {
              echo "FAIL: ${REPORT} missing or empty"
              exit 1
            }

            echo "PASS: ${REPORT}"
          done

          case "${ZAP_EXIT}" in
            0)
              echo 'PASS: OWASP ZAP baseline scan completed'
              ;;
            *)
              echo "FAIL: ZAP execution returned ${ZAP_EXIT}"
              exit "${ZAP_EXIT}"
              ;;
          esac

          echo 'OwaspZapImplemented=true'
        '''
      }
    }

    stage('22 Publish ZAP Report') {
      when {
        branch 'main'
      }

      steps {
        sh '''
          set -Eeuo pipefail

          test -s reports/phase-11-zap/zap-baseline.html
          test -s reports/phase-11-zap/zap-baseline.json
          test -s reports/phase-11-zap/zap-baseline.xml
          test -s reports/phase-11-zap/zap-baseline.md
          test -s reports/phase-11-zap/zap-console.log
          test -s reports/phase-11-zap/zap-exit.txt
        '''

        publishHTML([
          allowMissing: false,
          alwaysLinkToLastBuild: true,
          keepAll: true,
          reportDir: 'reports/phase-11-zap',
          reportFiles: 'zap-baseline.html',
          reportName: 'OWASP ZAP Baseline Report',
          reportTitles: 'Vault Bank OWASP ZAP Baseline'
        ])
      }
    }
    stage('23 Final evidence check') {
      steps {
        sh '''
          set -Eeuo pipefail

          git status --porcelain --untracked-files=no |
            tee reports/phase-02-ci-baseline/git-status-after.txt

          test ! -s \
            reports/phase-02-ci-baseline/git-status-after.txt

          if [ -f backend-service/coverage/coverage-summary.json ]; then
            cp \
              backend-service/coverage/coverage-summary.json \
              reports/phase-02-ci-baseline/
          fi

          test -s             reports/phase-06-trivy-fs/trivy-fs-combined.json

          test -s             reports/phase-06-trivy-fs/trivy-fs-summary.json

          test -s             reports/phase-06-trivy-fs/secret-misconfig.sarif

          test -s             reports/phase-06-trivy-fs/trivy-fs-table.txt

          grep -Eq             '"critical_vulnerabilities":[[:space:]]*0'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          grep -Eq             '"fixable_high_vulnerabilities":[[:space:]]*0'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          grep -Eq             '"high_or_critical_secrets":[[:space:]]*0'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          grep -Eq             '"high_or_critical_misconfigurations":[[:space:]]*0'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          grep -Eq             '"gate_passed":[[:space:]]*true'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          test -s             reports/phase-07-build/images.txt

          test -s             reports/phase-07-build/image-manifest.json

          IMAGE_COUNT="$(
            wc -l               < reports/phase-07-build/images.txt |
            tr -d '[:space:]'
          )"

          if [ "${IMAGE_COUNT}" -ne 6 ]; then
            echo               "FAIL: expected 6 built images, found ${IMAGE_COUNT}"
            exit 1
          fi

          if grep -Eq             ':latest$'             reports/phase-07-build/images.txt; then
            echo "FAIL: latest image tag is prohibited"
            exit 1
          fi

          while IFS= read -r image; do
            if [ -z "${image}" ]; then
              echo "FAIL: empty image reference"
              exit 1
            fi

            docker image inspect               "${image}"               >/dev/null

            runtime_user="$(
              docker image inspect                 --format '{{.Config.User}}'                 "${image}"
            )"

            case "${runtime_user}" in
              "" | "0" | "root")
                echo                   "FAIL: ${image} has invalid runtime user: ${runtime_user:-empty}"
                exit 1
                ;;
            esac

            echo               "PASS: ${image} runtime user=${runtime_user}"
          done             < reports/phase-07-build/images.txt

          echo             "PASS: CI, security and deterministic image evidence checks completed"

          test -s \
            reports/phase-08-trivy-image/trivy-image-summary.json

          test -s \
            reports/phase-08-trivy-image/trivy-image-summary.txt

          test -s \
            reports/phase-08-trivy-image/trivy-image-metadata.txt

          python3 - <<'PYTHON'
import json
from pathlib import Path

report_root = Path(
    "reports/phase-08-trivy-image"
)

summary_path = (
    report_root / "trivy-image-summary.json"
)

summary = json.loads(
    summary_path.read_text(encoding="utf-8")
)

if summary.get("images_scanned") != 6:
    raise SystemExit(
        "FAIL: Trivy image summary does not contain 6 images"
    )

totals = summary.get("totals") or {}

required_zero = {
    "critical_vulnerabilities": 0,
    "fixable_high_vulnerabilities": 0,
    "high_or_critical_secrets": 0,
    "high_or_critical_misconfigurations": 0,
}

for name, expected in required_zero.items():
    actual = totals.get(name)

    if actual != expected:
        raise SystemExit(
            f"FAIL: {name} expected {expected}, found {actual}"
        )

if summary.get("gate_passed") is not True:
    raise SystemExit(
        "FAIL: Trivy image gate_passed is not true"
    )

images = summary.get("images") or []

if len(images) != 6:
    raise SystemExit(
        f"FAIL: expected 6 image entries, found {len(images)}"
    )

report_requirements = (
    ("json", "*.json"),
    ("table", "*.txt"),
    ("sarif", "*.sarif"),
)

for directory, extension in report_requirements:
    report_count = len(
        list(
            (report_root / directory).glob(extension)
        )
    )

    if report_count != 6:
        raise SystemExit(
            f"FAIL: expected 6 {directory} reports, "
            f"found {report_count}"
        )

print(
    "PASS: six Trivy image reports and "
    "zero-finding security gate verified"
)
PYTHON

          echo \
            "PASS: container-image security evidence checks completed"


          test -s \
            reports/phase-09-sbom/sbom-summary.json

          test -s \
            reports/phase-09-sbom/sbom-summary.txt

          test -s \
            reports/phase-09-sbom/sbom-manifest.json

          test -s \
            reports/phase-09-sbom/sbom-checksums.sha256

          test -s \
            reports/phase-09-sbom/sbom-metadata.txt

