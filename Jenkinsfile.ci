    stage('24 DefectDojo API Preflight') {
      when {
        branch 'main'
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'defectdojo-api-token',
            variable: 'DEFECTDOJO_API_TOKEN'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            DEFECTDOJO_URL="${DEFECTDOJO_URL:-}"
            REPORT_DIR='reports/phase-12-defectdojo'
            ZAP_JSON='reports/phase-11-zap/zap-baseline.json'
            SELECTED_DEFECTDOJO_URL=''

            mkdir -p "${REPORT_DIR}"
            test -s "${ZAP_JSON}"
            command -v jq >/dev/null 2>&1

            : > "${REPORT_DIR}/defectdojo-candidates.txt"
            : > "${REPORT_DIR}/preflight-attempts.log"

            if [ -n "${DEFECTDOJO_URL}" ]; then
              printf '%s\n' "${DEFECTDOJO_URL}" \
                >> "${REPORT_DIR}/defectdojo-candidates.txt"
            fi

            if [ -n "${STAGING_NODE_IP:-}" ]; then
              printf 'http://%s:8081\n' "${STAGING_NODE_IP}" \
                >> "${REPORT_DIR}/defectdojo-candidates.txt"
            fi

            printf '%s\n' \
              'http://127.0.0.1:8081' \
              'http://localhost:8081' \
              >> "${REPORT_DIR}/defectdojo-candidates.txt"

            while IFS= read -r CANDIDATE_URL; do
              [ -n "${CANDIDATE_URL}" ] || continue

              printf 'Trying DefectDojoURL=%s\n' "${CANDIDATE_URL}" |
                tee -a "${REPORT_DIR}/preflight-attempts.log"

              set +e
              HTTP_STATUS="$(
                curl \
                  --silent \
                  --show-error \
                  --retry 5 \
                  --retry-delay 2 \
                  --retry-connrefused \
                  --connect-timeout 5 \
                  --max-time 20 \
                  --output "${REPORT_DIR}/preflight-response.json" \
                  --write-out '%{http_code}' \
                  --header "Authorization: Token ${DEFECTDOJO_API_TOKEN}" \
                  --header 'Accept: application/json' \
                  "${CANDIDATE_URL%/}/api/v2/products/?limit=1" \
                  2>"${REPORT_DIR}/preflight-curl.err"
              )"
              CURL_EXIT=$?
              set -e

              printf 'DefectDojoAttemptURL=%s HTTP=%s CurlExit=%s\n' \
                "${CANDIDATE_URL}" \
                "${HTTP_STATUS}" \
                "${CURL_EXIT}" |
                tee -a "${REPORT_DIR}/preflight-attempts.log"

              if [ "${CURL_EXIT}" -eq 0 ] &&
                [ "${HTTP_STATUS}" = '200' ]
              then
                SELECTED_DEFECTDOJO_URL="${CANDIDATE_URL%/}"
                break
              fi
            done < "${REPORT_DIR}/defectdojo-candidates.txt"

            if [ -z "${SELECTED_DEFECTDOJO_URL}" ]; then
              echo 'FAIL: DefectDojo API is not reachable or not authenticated'
              echo 'Start DefectDojo on port 8081 or set Jenkins parameter DEFECTDOJO_URL.'
              cat "${REPORT_DIR}/preflight-attempts.log"
              if [ -s "${REPORT_DIR}/preflight-curl.err" ]; then
                cat "${REPORT_DIR}/preflight-curl.err"
              fi
              exit 1
            fi

            DEFECTDOJO_URL="${SELECTED_DEFECTDOJO_URL}"
            printf '%s\n' "${DEFECTDOJO_URL}" \
              > "${REPORT_DIR}/defectdojo-url.txt"

            printf 'DefectDojoAPIHTTP=%s\n' "${HTTP_STATUS}"
            test "${HTTP_STATUS}" = '200'
            jq -e 'type == "object"' \
              "${REPORT_DIR}/preflight-response.json" >/dev/null

            echo 'PASS: DefectDojo API authenticated'
            echo 'DefectDojoReady=true'
          '''
        }
      }
    }

    stage('25 DefectDojo ZAP Reimport') {
      when {
        branch 'main'
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'defectdojo-api-token',
            variable: 'DEFECTDOJO_API_TOKEN'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            REPORT_DIR='reports/phase-12-defectdojo'
            DEFECTDOJO_URL="$(
              tr -d '[:space:]' < "${REPORT_DIR}/defectdojo-url.txt"
            )"
            ZAP_JSON='reports/phase-11-zap/zap-baseline.json'
            ZAP_XML='reports/phase-11-zap/zap-baseline.xml'
            BUILD_ID_VALUE="${BUILD_NUMBER:-local}"
            BRANCH_TAG_VALUE="${BRANCH_NAME:-main}"
            COMMIT_HASH_VALUE="${GIT_COMMIT:-$(git rev-parse HEAD)}"

            mkdir -p "${REPORT_DIR}"
            test -n "${DEFECTDOJO_URL}"
            test -s "${ZAP_JSON}"
            test -s "${ZAP_XML}"
            command -v jq >/dev/null 2>&1

            set +e
            HTTP_STATUS="$(
              curl \
                --silent \
                --show-error \
                --retry 5 \
                --retry-delay 2 \
                --retry-connrefused \
                --connect-timeout 5 \
                --max-time 60 \
                --output "${REPORT_DIR}/import-response.json" \
                --write-out '%{http_code}' \
                --header "Authorization: Token ${DEFECTDOJO_API_TOKEN}" \
                --form 'scan_type=ZAP Scan' \
                --form 'minimum_severity=Info' \
                --form 'active=true' \
                --form 'verified=false' \
                --form 'close_old_findings=false' \
                --form 'do_not_reactivate=false' \
                --form 'auto_create_context=true' \
                --form 'product_type_name=DevSecOps Practice' \
                --form 'product_name=Vault Bank' \
                --form 'engagement_name=Jenkins Security Pipeline' \
                --form 'test_title=Jenkins OWASP ZAP Baseline' \
                --form "build_id=${BUILD_ID_VALUE}" \
                --form "branch_tag=${BRANCH_TAG_VALUE}" \
                --form "commit_hash=${COMMIT_HASH_VALUE}" \
                --form 'background_import=false' \
                --form "file=@${ZAP_XML};type=application/xml" \
                "${DEFECTDOJO_URL%/}/api/v2/reimport-scan/" \
                2>"${REPORT_DIR}/import-curl.err"
            )"
            CURL_EXIT=$?
            set -e

            printf '%s\n' "${HTTP_STATUS}" \
              > "${REPORT_DIR}/import-http.txt"
            printf 'DefectDojoImportHTTP=%s\n' "${HTTP_STATUS}"

            if [ "${CURL_EXIT}" -ne 0 ]; then
              echo "FAIL: DefectDojo reimport curl failed with exit ${CURL_EXIT}"
              cat "${REPORT_DIR}/import-curl.err"
              exit 1
            fi

            case "${HTTP_STATUS}" in
              200|201)
                ;;
              *)
                echo "FAIL: DefectDojo reimport returned ${HTTP_STATUS}"
                exit 1
                ;;
            esac

            jq -e 'type == "object"' \
              "${REPORT_DIR}/import-response.json" >/dev/null

            TEST_ID="$(
              jq -r '
                def numeric_id:
                  if type == "number" then tostring
                  elif type == "string" and test("^[0-9]+$") then .
                  elif type == "string"
                    and test("/tests/[0-9]+/?$")
                  then capture("/tests/(?<id>[0-9]+)/?$").id
                  elif type == "object"
                    and (.id? | type == "number")
                  then (.id | tostring)
                  elif type == "object"
                    and (.id? | type == "string")
                    and (.id | test("^[0-9]+$"))
                  then .id
                  elif type == "object"
                    and (.id? | type == "string")
                    and (.id | test("/tests/[0-9]+/?$"))
                  then (
                    .id |
                    capture("/tests/(?<id>[0-9]+)/?$").id
                  )
                  else empty
                  end;

                [
                  (.test_id? | numeric_id),
                  (.test? | numeric_id),
                  (.data?.test_id? | numeric_id),
                  (.data?.test? | numeric_id),
                  (.results?.test_id? | numeric_id),
                  (.results?.test? | numeric_id),
                  (.. | objects | .test_id? | numeric_id),
                  (.. | objects | .test? | numeric_id)
                ]
                | map(select(. != ""))
                | .[0] // empty
              ' "${REPORT_DIR}/import-response.json"
            )"

            if ! printf '%s\n' "${TEST_ID}" |
              grep -Eq '^[0-9]+$'
            then
              echo 'FAIL: unable to determine DefectDojo Test ID'
              exit 1
            fi

            printf '%s\n' "${TEST_ID}" \
              > "${REPORT_DIR}/test-id.txt"
            printf 'DefectDojoTestID=%s\n' "${TEST_ID}"

            echo 'PASS: ZAP report imported into DefectDojo'
            echo 'DefectDojoImplemented=true'
          '''
        }
      }
    }

    stage('26 DefectDojo Findings Gate') {
      when {
        branch 'main'
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'defectdojo-api-token',
            variable: 'DEFECTDOJO_API_TOKEN'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            REPORT_DIR='reports/phase-12-defectdojo'
            DEFECTDOJO_URL="$(
              tr -d '[:space:]' < "${REPORT_DIR}/defectdojo-url.txt"
            )"
            TEST_ID="$(
              tr -d '[:space:]' < "${REPORT_DIR}/test-id.txt"
            )"

            test -n "${DEFECTDOJO_URL}"
            test -n "${TEST_ID}"
            command -v jq >/dev/null 2>&1

            set +e
            HTTP_STATUS="$(
              curl \
                --silent \
                --show-error \
                --retry 5 \
                --retry-delay 2 \
                --retry-connrefused \
                --connect-timeout 5 \
                --max-time 30 \
                --output "${REPORT_DIR}/findings.json" \
                --write-out '%{http_code}' \
                --header "Authorization: Token ${DEFECTDOJO_API_TOKEN}" \
                --header 'Accept: application/json' \
                "${DEFECTDOJO_URL%/}/api/v2/findings/?test=${TEST_ID}&active=true&limit=200" \
                2>"${REPORT_DIR}/findings-curl.err"
            )"
            CURL_EXIT=$?
            set -e

            printf 'DefectDojoFindingsHTTP=%s\n' "${HTTP_STATUS}"
            if [ "${CURL_EXIT}" -ne 0 ]; then
              echo "FAIL: DefectDojo findings curl failed with exit ${CURL_EXIT}"
              cat "${REPORT_DIR}/findings-curl.err"
              exit 1
            fi

            test "${HTTP_STATUS}" = '200'
            jq -e 'type == "object"' \
              "${REPORT_DIR}/findings.json" >/dev/null

            count_severity() {
              jq -r \
                --arg severity "$1" \
                '[.results[]? | select(.severity == $severity)] | length' \
                "${REPORT_DIR}/findings.json"
            }

            CRITICAL_COUNT="$(count_severity Critical)"
            HIGH_COUNT="$(count_severity High)"
            MEDIUM_COUNT="$(count_severity Medium)"
            LOW_COUNT="$(count_severity Low)"
            INFO_COUNT="$(count_severity Info)"

            printf 'CriticalFindings=%s\n' "${CRITICAL_COUNT}"
            printf 'HighFindings=%s\n' "${HIGH_COUNT}"
            printf 'MediumFindings=%s\n' "${MEDIUM_COUNT}"
            printf 'LowFindings=%s\n' "${LOW_COUNT}"
            printf 'InfoFindings=%s\n' "${INFO_COUNT}"

            if [ "${CRITICAL_COUNT}" -gt 0 ] ||
              [ "${HIGH_COUNT}" -gt 0 ]
            then
              echo 'FAIL: active Critical/High DefectDojo findings found'
              exit 1
            fi

            for evidence_file in \
              preflight-response.json \
              defectdojo-url.txt \
              import-response.json \
              import-http.txt \
              test-id.txt \
              findings.json
            do
              test -s "${REPORT_DIR}/${evidence_file}"
            done

            echo 'PASS: no active Critical/High DefectDojo findings'
            echo 'DefectDojoSecurityGate=true'
          '''
        }
      }
    }

        stage('27 Argo CD Deploy - Production') {
          when {
            branch 'main'
          }

          options {
            timeout(time: 15, unit: 'MINUTES')
          }

          steps {
            sh '''
              set -Eeuo pipefail

              REPORT_DIR='reports/phase-27-production' \
              bash ci/scripts/verify-production-deployment.sh
            '''
          }
        }

    stage('28 Prometheus Monitoring Verification') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 5, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          bash ci/scripts/verify-prometheus-monitoring.sh
        '''
      }
    }

    stage('29 Alertmanager Integration Verification') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 5, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          PROMETHEUS_URL='http://127.0.0.1:30900'
          REPORT_DIR='reports/phase-28-alertmanager'

          mkdir -p "${REPORT_DIR}"

          echo '=================================================='
          echo 'ALERTMANAGER INTEGRATION VERIFICATION'
          echo '=================================================='

          command -v curl >/dev/null 2>&1
          command -v jq >/dev/null 2>&1

          echo
          echo '========== PROMETHEUS READINESS =========='

          curl \
            --silent \
            --show-error \
            --fail \
            "${PROMETHEUS_URL}/-/ready" \
            | tee "${REPORT_DIR}/prometheus-ready.txt"

          echo
          echo '========== ALERTMANAGER DISCOVERY =========='

          curl \
            --silent \
            --show-error \
            --fail \
            "${PROMETHEUS_URL}/api/v1/alertmanagers" \
            > "${REPORT_DIR}/alertmanagers.json"

          jq . "${REPORT_DIR}/alertmanagers.json"

          ACTIVE="$(
            jq '
              .data.activeAlertmanagers | length
            ' "${REPORT_DIR}/alertmanagers.json"
          )"

          DROPPED="$(
            jq '
              .data.droppedAlertmanagers | length
            ' "${REPORT_DIR}/alertmanagers.json"
          )"

          echo
          echo "ActiveAlertmanagers=${ACTIVE}"
          echo "DroppedAlertmanagers=${DROPPED}"

          if [ "${ACTIVE}" -lt 1 ]; then
            echo 'FAIL: no active Alertmanager configured'
            exit 1
          fi

          if ! jq -e '
            [
              .data.activeAlertmanagers[]?
              | .url
              | select(
                  contains("alertmanager")
                  and
                  contains("9093")
                )
            ]
            | length >= 1
          ' "${REPORT_DIR}/alertmanagers.json" >/dev/null
          then
            echo 'FAIL: expected alertmanager:9093 not discovered'
            exit 1
          fi

          echo
          echo '========== ACTIVE ALERTMANAGER URL =========='

          jq -r \
            '.data.activeAlertmanagers[]?.url' \
            "${REPORT_DIR}/alertmanagers.json"

          echo
          echo '========== ALERT RULES =========='

          curl \
            --silent \
            --show-error \
            --fail \
            "${PROMETHEUS_URL}/api/v1/rules" \
            > "${REPORT_DIR}/rules.json"

          jq -r '
            .data.groups[]? as $group
            | $group.rules[]?
            |
            [
              $group.name,
              .name,
              (.state // "unknown"),
              (.health // "unknown")
            ]
            | @tsv
          ' "${REPORT_DIR}/rules.json" \
          | tee "${REPORT_DIR}/rules.txt"

          RULE_COUNT="$(
            jq '
              [
                .data.groups[]?.rules[]?
              ]
              | length
            ' "${REPORT_DIR}/rules.json"
          )"

          UNHEALTHY_RULES="$(
            jq '
              [
                .data.groups[]?.rules[]?
                | select(
                    (.health // "unknown") != "ok"
                  )
              ]
              | length
            ' "${REPORT_DIR}/rules.json"
          )"

          echo
          echo "PrometheusRuleCount=${RULE_COUNT}"
          echo "UnhealthyRules=${UNHEALTHY_RULES}"

          if [ "${RULE_COUNT}" -lt 3 ]; then
            echo 'FAIL: expected at least 3 Vault Bank alert rules'
            exit 1
          fi

          if [ "${UNHEALTHY_RULES}" -ne 0 ]; then
            echo 'FAIL: unhealthy Prometheus alert rules detected'
            exit 1
          fi

          cat > "${REPORT_DIR}/summary.txt" <<SUMMARY
ActiveAlertmanagers=${ACTIVE}
DroppedAlertmanagers=${DROPPED}
PrometheusRuleCount=${RULE_COUNT}
UnhealthyRules=${UNHEALTHY_RULES}
AlertmanagerConnected=true
AlertmanagerVerificationPassed=true
SUMMARY

          echo
          echo '========== ALERTMANAGER SUMMARY =========='
          cat "${REPORT_DIR}/summary.txt"

          echo
          echo 'PASS: Alertmanager integration verification completed'
        '''
      }
    }

    stage('30 Grafana Monitoring Verification') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 5, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'grafana-admin',
            usernameVariable: 'GRAFANA_USER',
            passwordVariable: 'GRAFANA_PASSWORD'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            export GRAFANA_URL='http://127.0.0.1:30300'

            bash ci/scripts/verify-grafana.sh
          '''
        }
      }
    }

  }

  post {
    always {
      archiveArtifacts(
        artifacts: 'reports/**,backend-service/coverage/**',
        allowEmptyArchive: true,
        fingerprint: true
      )

      cleanWs(
        deleteDirs: true,
        notFailBuild: true
      )
    }

    failure {
      echo 'NO-GO: the CI baseline failed. Do not merge this change.'
    }

    success {
      echo 'GO: supply-chain gates, Harbor publication, OWASP ZAP, DefectDojo and Prometheus monitoring verification completed successfully.'
    }
  }
}
